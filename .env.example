# --- Gemini Key ---- #
GEMINI_API_KEY=""

# --- Binance Futures TESTNET API keys (testnet.binancefuture.com / demo.binance.com) ---
# When set, the engine places real signed orders on the testnet on live cascades.
BINANCE_KEY=""
BINANCE_SECRET=""
BYBIT_ENV="testnet"

# --- Cascade entry offset from the liquidation price, as a fraction (0.0035 = 0.35%) ---
# Raise it in volatile markets (e.g. 0.006), lower it in quiet ones. Defaults to 0.0035.
VACUUM_OFFSET_PCT="0.0035"

# -- Telegram Credentials --- #
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""

# --- App URL --- #
APP_URL=""

# --- Server port (default 3000 in-container; docker-compose maps host 4500 -> 3000) ---
PORT=3000
