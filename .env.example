# --- Gemini Key ---- #
GEMINI_API_KEY=""

# --- Binance Futures demo/testnet API keys: used only when "Mirror to Binance demo" is on ---
# Optional: BINANCE_DEMO_REST_BASE (default https://testnet.binancefuture.com)
BINANCE_KEY=""
BINANCE_SECRET=""
BYBIT_ENV="testnet"
# -- Telegram Credentials --- #
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""

# --- App URL --- #
APP_URL=""

# --- Server port (default 3000 in-container; docker-compose maps host 4500 -> 3000) ---
PORT=3000

# Optional durable config, shadow journal and demo mirror journal directory (default .lsv-state)
# LSV_STATE_DIR=/app/.lsv-state
