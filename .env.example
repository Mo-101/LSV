# --- Gemini Key ---- #
GEMINI_API_KEY=""

# --- Binance Futures TESTNET API keys (testnet.binancefuture.com / demo.binance.com) ---
# Credentials enable demo connectivity. Backend mode and automatic-entry settings control execution.
BINANCE_KEY=""
BINANCE_SECRET=""
BYBIT_ENV="testnet"
# -- Telegram Credentials --- #
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""

# --- App URL --- #
APP_URL=""

# --- Server port (default 3000 in-container; docker-compose maps host 4500 -> 3000) ---
PORT=3000

# Optional durable config and execution journal directory (default .lsv-state)
# LSV_STATE_DIR=/app/.lsv-state
